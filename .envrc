# Auto-activate the oriented-det uv venv for blog posts that run `odet` inference.
# One-time setup: direnv allow
# Override the repo path locally: create .envrc.local with export ORIENTED_DET_ROOT=/path/to/oriented-det

source_env_if_exists .envrc.local

ORIENTED_DET_ROOT="${ORIENTED_DET_ROOT:-$HOME/Projects/oriented-det}"
VENV="$ORIENTED_DET_ROOT/.venv"

if [ ! -x "$VENV/bin/python" ]; then
  echo "oriented-det venv not found at $VENV" >&2
  echo "Create it: cd \$ORIENTED_DET_ROOT && uv venv --python 3.12 && uv pip install torch torchvision && uv pip install -r requirements.txt && uv pip install -e ." >&2
  exit 1
fi

export VIRTUAL_ENV="$VENV"
export ORIENTED_DET_ROOT
PATH_add "$VENV/bin"
